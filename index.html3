
<!DOCTYPE html>
<html lang="am">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<meta name="theme-color" content="#030712">
<meta name="description" content="AL NASIR Live File Tracking & Admin">
<title>AL NASIR - Live File Tracking</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
body{background:#030712;color:#fff;min-height:100vh;overflow-x:hidden}
button,input,select{font:inherit}
button{cursor:pointer}
.app{width:100%;max-width:560px;min-height:100vh;margin:auto;background:#050a17;padding-bottom:35px}
header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:16px;background:rgba(5,10,23,.98);border-bottom:1px solid #1f2937}
.logo h1{font-size:1.35rem;letter-spacing:2px}.logo p{font-size:.58rem;color:#9ca3af;letter-spacing:1px;margin-top:3px}
.connection{font-size:.65rem;padding:6px 9px;border-radius:20px;background:#3f1d1d;color:#fca5a5;border:1px solid #7f1d1d}
.connection.ok{background:#052e25;color:#6ee7b7;border-color:#047857}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:16px 16px 0}
.tab{padding:13px 8px;border:1px solid #1e293b;border-radius:10px;background:#0b1329;color:#9ca3af;font-weight:800}
.tab.active{color:#fff;border-color:#059669;background:rgba(5,150,105,.15)}
.content{padding:16px}
.card,.file{background:#070d1e;border:1px solid #1e293b;border-radius:15px;padding:16px;margin-bottom:16px}
.title{font-size:1.05rem;font-weight:800;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;gap:8px}
label{display:block;font-size:.65rem;color:#9ca3af;letter-spacing:1px;margin:0 0 6px}
input,select{width:100%;padding:13px;background:#050a17;color:#fff;border:1px solid #1e293b;border-radius:9px;outline:0;margin-bottom:12px;font-size:16px}
input:focus,select:focus{border-color:#059669;box-shadow:0 0 0 2px rgba(5,150,105,.12)}
.btn{width:100%;padding:13px;border:0;border-radius:9px;font-weight:800;font-size:.9rem}
.track{border:1px solid #b45309;background:linear-gradient(90deg,#451a03,#78350f);color:#fff}.track .am{color:#fed7aa}.track .en{font-size:.72rem;color:#fb923c;margin-top:3px}
.green{background:#059669;color:#fff}.dark{background:#1e293b;color:#fff}.red{background:#991b1b;color:#fff}.blue{background:#2563eb;color:#fff}.orange{background:#d97706;color:#fff}
.small{width:auto;padding:8px 12px;font-size:.75rem}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:10px}
.stat{background:#0d1527;border:1px solid #1e293b;border-radius:10px;padding:12px;text-align:center}.stat b{display:block;font-size:1.35rem}.stat span{font-size:.62rem;color:#9ca3af;font-weight:700}
.file{background:#0a1122}.filetop{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:8px}.receipt{color:#f59e0b;font-weight:800}.badge{padding:4px 7px;border:1px solid #059669;border-radius:6px;color:#34d399;background:rgba(5,150,105,.15);font-size:.62rem;font-weight:700}
.name{font-weight:800;margin-bottom:5px}.meta{color:#9ca3af;font-size:.78rem;margin:4px 0}.meta b{display:inline-block;width:90px;color:#6b7280}
#trackResults,#adminSection,#adminPanel{display:none}
.searchHint,.note{color:#9ca3af;font-size:.78rem;margin-top:8px;line-height:1.5}
.notice{margin-top:12px;padding:10px;border:1px solid #1e293b;border-radius:9px;color:#9ca3af;font-size:.75rem;line-height:1.5}
.modal{display:none;position:fixed;inset:0;z-index:1000;background:rgba(3,7,18,.97);overflow:auto;padding:18px 14px}
.modalbox{max-width:450px;margin:auto;background:#070d1e;border:1px solid #1e293b;border-radius:16px;padding:20px;position:relative}
.close{position:absolute;right:12px;top:12px;border:0;background:#1f2937;color:#fff;width:32px;height:32px;border-radius:50%;font-size:18px}
.steps{display:grid;gap:7px;margin:18px 0}.step{display:flex;gap:10px;align-items:center;padding:11px;background:#0b1329;border:1px solid #1e293b;border-radius:8px;color:#6b7280;font-size:.84rem}.dot{width:13px;height:13px;border-radius:50%;background:#374151;flex:none}.step.active{border-color:#059669;color:#fff;font-weight:700}.step.active .dot{background:#10b981;box-shadow:0 0 9px #10b981}.step.done{border-color:#78350f;color:#d1d5db}.step.done .dot{background:#d97706}
.qr{background:#0b1329;border:1px solid #1f2937;border-radius:11px;padding:15px;text-align:center;margin-bottom:12px}.qr img{width:150px;height:150px;background:#fff;padding:5px;border-radius:8px}
.toast{position:fixed;left:50%;bottom:22px;z-index:2000;transform:translate(-50%,80px);opacity:0;background:#059669;padding:11px 18px;border-radius:25px;font-weight:700;font-size:.82rem;transition:.25s;white-space:nowrap;max-width:90vw;text-align:center}.toast.show{transform:translate(-50%,0);opacity:1}
.empty{color:#9ca3af;text-align:center;padding:15px;font-size:.85rem}
.loading{padding:16px;text-align:center;color:#9ca3af}
.errorbox{display:none;margin-bottom:12px;padding:11px;border:1px solid #991b1b;background:#3b0d0d;color:#fecaca;border-radius:9px;font-size:.78rem;line-height:1.45}
footer{text-align:center;color:#64748b;font-size:.7rem;padding:10px 16px 0}
@media(max-width:390px){.tabs{gap:6px}.content{padding:12px}.card{padding:14px}.three{grid-template-columns:1fr}.meta b{width:78px}}
</style>
</head>

<body>
<div class="app">
<header>
  <div class="logo">
    <h1>AL NASIR</h1>
    <p>COMMISSION & TRAVEL AGENT</p>
  </div>
  <div id="connection" class="connection">Connecting...</div>
</header>

<div class="tabs">
  <button class="tab active" id="tabTrack" onclick="switchTab('track')">Track Files</button>
  <button class="tab" id="tabAdmin" onclick="switchTab('admin')">Admin Panel</button>
</div>

<main class="content">

<section id="trackSection">
  <div class="card">
    <div class="title">Search Application</div>
    <label>RECEIPT NUMBER (ደረሰኝ)</label>
    <input id="referenceInput" placeholder="ATT-2026-0001" autocomplete="off">

    <label>MOBILE NUMBER (ስልክ)</label>
    <input id="phoneInput" type="tel" inputmode="tel" placeholder="09xxxxxxxx" autocomplete="tel">

    <div id="searchError" class="errorbox"></div>

    <button class="btn track" id="searchBtn" onclick="executeSearch()">
      <div class="am">የፋይሎችዎን ሂደት ይከታተሉ</div>
      <div class="en">TRACK PROGRESS</div>
    </button>
    <div class="searchHint">Receipt ወይም phone በመጠቀም ፋይልዎን ይፈልጉ።</div>
  </div>

  <div id="trackResults">
    <div class="card">
      <div class="title"><span><b id="totalFiles">0</b> Files Found</span></div>
      <div id="displayPhone" style="color:#9ca3af;font-size:.82rem"></div>
      <div class="stats">
        <div class="stat"><b id="embassyCount">0</b><span>IN PROCESS</span></div>
        <div class="stat"><b id="readyCount">0</b><span>READY / DONE</span></div>
      </div>
    </div>
    <div id="fileList"></div>
  </div>
</section>

<section id="adminSection">
  <div id="adminLogin" class="card">
    <div class="title">Admin Login</div>
    <div class="note" style="margin-bottom:12px">Use the email and password created in Supabase Authentication.</div>
    <label>ADMIN EMAIL</label>
    <input id="adminEmail" type="email" placeholder="admin@example.com" autocomplete="username">
    <label>PASSWORD</label>
    <input id="adminPassword" type="password" placeholder="Enter password" autocomplete="current-password">
    <div id="loginError" class="errorbox"></div>
    <button class="btn green" onclick="adminLogin()">Secure Login</button>
    <div class="notice">If login says invalid credentials, create the admin user under Supabase → Authentication → Users.</div>
  </div>

  <div id="adminPanel">
    <div class="card">
      <div class="title">
        <span>System Overview</span>
        <button class="btn small dark" onclick="loadFiles()">Refresh</button>
      </div>
      <div id="adminUser" class="note"></div>
      <div class="stats">
        <div class="stat"><b id="statTotal">0</b><span>TOTAL</span></div>
        <div class="stat"><b id="statEmbassy">0</b><span>EMBASSY</span></div>
        <div class="stat"><b id="statReady">0</b><span>READY</span></div>
        <div class="stat"><b id="statCollected">0</b><span>COLLECTED</span></div>
      </div>
    </div>

    <div class="card">
      <div class="title">
        <span id="formTitle">Add New File</span>
        <button class="btn small blue" onclick="generateReceipt()">Auto Ref</button>
      </div>

      <input type="hidden" id="editingReceipt">

      <label>RECEIPT NUMBER *</label>
      <input id="adminReceipt" placeholder="ATT-2026-0001">

      <label>CUSTOMER NAME *</label>
      <input id="adminName" placeholder="Full name">

      <label>PHONE NUMBER *</label>
      <input id="adminPhone" type="tel" placeholder="0900000000">

      <label>DOCUMENT TYPE</label>
      <input id="adminType" placeholder="Police clearance">

      <label>MOFA REFERENCE</label>
      <input id="adminMofa" placeholder="ATS-2026...">

      <label>STATUS</label>
      <select id="adminStatus">
        <option>Received</option>
        <option>At embassy</option>
        <option>Embassy done</option>
        <option>Ready to collect</option>
        <option>Collected</option>
      </select>

      <div class="two">
        <button class="btn green" onclick="saveFile()">Save File</button>
        <button class="btn dark" onclick="clearForm()">Clear</button>
      </div>
    </div>

    <div class="card">
      <div class="title">Database Management</div>
      <input id="adminSearch" placeholder="Search name or receipt..." oninput="renderAdminFiles()">
      <div id="adminFiles"><div class="loading">Loading...</div></div>
    </div>

    <button class="btn red" onclick="adminLogout()">Logout</button>
  </div>
</section>

</main>

<footer>
  AL NASIR - Commission & Travel Agent<br>
  0900494900
</footer>
</div>

<div class="modal" id="modal">
  <div class="modalbox">
    <button class="close" onclick="closeModal()">✕</button>
    <div style="color:#6b7280;font-size:.7rem;font-weight:700">AL NASIR LIVE TRACKING</div>
    <h2 id="mStatus" style="margin:5px 0;color:#fff">Status</h2>
    <div id="mReceipt" style="color:#f59e0b;font-weight:800;margin-bottom:14px"></div>
    <div class="meta"><b>Customer:</b><span id="mName"></span></div>
    <div class="meta"><b>Phone:</b><span id="mPhone"></span></div>
    <div class="meta"><b>MOFA REF:</b><span id="mMofa"></span></div>

    <div style="background:rgba(6,78,59,.4);border:1px solid #059669;border-radius:9px;padding:11px;margin:14px 0">
      <div id="mEng" style="color:#6ee7b7;font-size:.8rem"></div>
      <div id="mAmh" style="font-weight:700;font-size:.85rem;margin-top:3px"></div>
    </div>

    <div class="steps" id="steps"></div>

    <div class="qr">
      <img id="qrImage" alt="Tracking QR">
      <div id="qrName" style="font-weight:700;margin-top:7px"></div>
      <div id="qrRef" style="color:#9ca3af;font-size:.78rem"></div>
    </div>

    <div class="two">
      <button class="btn green" onclick="shareWhatsApp()">WhatsApp</button>
      <button class="btn orange" onclick="copyLink()">Copy Link</button>
    </div>
  </div>
</div>

<div class="toast" id="toast">Done</div>

<script>
/* ============================================================
   AL NASIR TRACKING SYSTEM
   IMPORTANT:
   1. This file uses Supabase Auth for Admin login.
   2. The publishable key is safe to put in browser code.
   3. Never put a Supabase service_role/secret key in this file.
   ============================================================ */

const SUPABASE_URL = "https://cxlaebwiibzvedaupmtr.supabase.co";

/* Your supplied key. Publishable keys normally begin with sb_publishable_ */
const SUPABASE_KEY = "sb_publishable_wwJIy_f5u8ZKYYKi1w87aA_CVHt_7Ou";

let db = null;
let filesDatabase = {};
let activeReceipt = null;
let loading = false;
let loggedIn = false;
let realtimeChannel = null;

const STATUSES = [
  "Received",
  "At embassy",
  "Embassy done",
  "Ready to collect",
  "Collected"
];

function esc(v){
  return String(v ?? "").replace(/[&<>"']/g,m=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
  }[m]));
}

function normalizePhone(v){
  let p = String(v || "").replace(/[^\d+]/g,"");
  if(p.startsWith("+251")) return "0" + p.slice(4);
  if(p.startsWith("251")) return "0" + p.slice(3);
  return p;
}

function toast(msg){
  const t=document.getElementById("toast");
  t.textContent=msg;
  t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"),2500);
}

function showError(id,msg){
  const el=document.getElementById(id);
  el.textContent=msg;
  el.style.display="block";
}

function hideError(id){
  const el=document.getElementById(id);
  el.textContent="";
  el.style.display="none";
}

function setConnection(ok,msg){
  const el=document.getElementById("connection");
  el.textContent=msg;
  el.classList.toggle("ok",ok);
}

function switchTab(t){
  const track=t==="track";
  document.getElementById("trackSection").style.display=track?"block":"none";
  document.getElementById("adminSection").style.display=track?"none":"block";
  document.getElementById("tabTrack").classList.toggle("active",track);
  document.getElementById("tabAdmin").classList.toggle("active",!track);
}

function makeFile(row){
  return {
    receipt: String(row.receipt || "").toUpperCase(),
    name: row.name || "",
    phone: row.phone || "",
    type: row.type || "General Document",
    mofaRef: row.mofa_ref || "N/A",
    status: row.status || "Received"
  };
}

function initSupabase(){
  try{
    if(!window.supabase || typeof window.supabase.createClient!=="function"){
      throw new Error("Supabase library did not load.");
    }
    db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
    setConnection(true,"Online");
    return true;
  }catch(e){
    console.error(e);
    setConnection(false,"Offline");
    showError("searchError","Supabase could not start: "+e.message);
    return false;
  }
}

async function loadFiles(){
  if(loading || !db) return;
  loading=true;

  try{
    const {data,error}=await db
      .from("files")
      .select("receipt,name,phone,type,mofa_ref,status")
      .order("receipt",{ascending:false});

    if(error) throw error;

    filesDatabase={};
    (data || []).forEach(r=>{
      if(r.receipt) filesDatabase[String(r.receipt).toUpperCase()]=makeFile(r);
    });

    updateOverview();
    if(loggedIn) renderAdminFiles();

    setConnection(true,"Online");
    checkUrl();
  }catch(e){
    console.error("Load files error:",e);
    setConnection(false,"Database error");
    const msg = friendlyDbError(e);
    showError("searchError",msg);
    if(loggedIn) document.getElementById("adminFiles").innerHTML=
      '<div class="empty">'+esc(msg)+'</div>';
  }finally{
    loading=false;
  }
}

function friendlyDbError(e){
  const s=String(e?.message || e || "");
  if(/Invalid API key/i.test(s)) return "Invalid Supabase publishable key. Check SUPABASE_KEY in this HTML.";
  if(/Failed to fetch/i.test(s)) return "Database connection failed. Check Supabase URL, internet connection, and project status.";
  if(/relation .* does not exist|Could not find the table/i.test(s)) return 'The "files" table is missing. Create the table in Supabase SQL Editor.';
  if(/permission denied|row-level security|RLS|not allowed/i.test(s)) return "Supabase RLS policy is blocking this operation. Add the SQL policies supplied with this file.";
  return "Database error: "+s;
}

function checkUrl(){
  const q=new URLSearchParams(location.search);
  const ref=(q.get("ref")||"").trim().toUpperCase();
  const phone=q.get("phone")||"";

  if(ref){
    document.getElementById("referenceInput").value=ref;
    const f=filesDatabase[ref];
    if(f){
      document.getElementById("trackResults").style.display="block";
      executeSearch().then(()=>openLiveTracking(ref));
    }else{
      executeSearch();
    }
  }else if(phone){
    document.getElementById("phoneInput").value=phone;
    executeSearch();
  }
}

async function executeSearch(){
  hideError("searchError");

  const ref=document.getElementById("referenceInput").value.trim().toUpperCase();
  const phone=normalizePhone(document.getElementById("phoneInput").value.trim());

  if(!ref && !phone){
    showError("searchError","እባክዎ ደረሰኝ ወይም ስልክ ቁጥር ያስገቡ።");
    return;
  }

  if(!db){
    showError("searchError","Database is not connected.");
    return;
  }

  const btn=document.getElementById("searchBtn");
  btn.disabled=true;
  btn.style.opacity=".65";

  try{
    /*
      Search directly in Supabase so the page still works even when
      the browser has not previously loaded all records.
    */
    let data,error;

    if(ref){
      const r=await db.from("files")
        .select("receipt,name,phone,type,mofa_ref,status")
        .eq("receipt",ref)
        .limit(1);
      data=r.data; error=r.error;
    }else{
      const r=await db.from("files")
        .select("receipt,name,phone,type,mofa_ref,status")
        .eq("phone",phone)
        .order("receipt",{ascending:false});
      data=r.data; error=r.error;
    }

    if(error) throw error;

    const results=(data||[]).map(makeFile);

    if(!results.length){
      document.getElementById("trackResults").style.display="none";
      showError("searchError","ምንም ፋይል አልተገኘም። No application found.");
      return;
    }

    results.forEach(f=>filesDatabase[f.receipt]=f);

    document.getElementById("trackResults").style.display="block";
    document.getElementById("totalFiles").textContent=results.length;
    document.getElementById("displayPhone").textContent="Phone: "+(phone||results[0].phone);
    document.getElementById("embassyCount").textContent=
      results.filter(f=>["Received","At embassy"].includes(f.status)).length;
    document.getElementById("readyCount").textContent=
      results.filter(f=>["Embassy done","Ready to collect","Collected"].includes(f.status)).length;

    document.getElementById("fileList").innerHTML=results.map(f=>`
      <div class="file">
        <div class="filetop">
          <span class="receipt">${esc(f.receipt)}</span>
          <span class="badge">${esc(f.status.toUpperCase())}</span>
        </div>
        <div class="name">${esc(f.name)}</div>
        <div class="meta"><b>Type:</b>${esc(f.type)}</div>
        <div class="meta"><b>MOFA Ref:</b>${esc(f.mofaRef)}</div>
        <button class="btn-open-live"
          style="margin-top:10px;background:none;border:0;color:#f59e0b;font-weight:700;cursor:pointer"
          onclick="openLiveTracking('${encodeURIComponent(f.receipt)}')">
          Open Live Tracking →
        </button>
      </div>
    `).join("");

  }catch(e){
    console.error(e);
    showError("searchError",friendlyDbError(e));
  }finally{
    btn.disabled=false;
    btn.style.opacity="1";
  }
}

function directLink(file){
  return `${location.origin}${location.pathname}?ref=${encodeURIComponent(file.receipt)}`;
}

function openLiveTracking(encoded){
  const receipt=decodeURIComponent(encoded);
  const f=filesDatabase[receipt];
  if(!f) return;

  activeReceipt=f.receipt;

  document.getElementById("mStatus").textContent=f.status;
  document.getElementById("mReceipt").textContent=f.receipt;
  document.getElementById("mName").textContent=f.name;
  document.getElementById("mPhone").textContent=f.phone;
  document.getElementById("mMofa").textContent=f.mofaRef;

  const alerts={
    "Received":["File received at office.","ፋይልዎ በቢሮአችን ተቀብለናል።"],
    "At embassy":["Submitted to embassy.","ፋይልዎ ወደ ኤምባሲ ገብቷል።"],
    "Embassy done":["Attestation complete at embassy.","በኤምባሲ ማረጋገጫ ተጠናቋል።"],
    "Ready to collect":["Document is ready for pickup!","ሰነድዎ ለማንሳት ዝግጁ ነው!"],
    "Collected":["Document collected.","ሰነዱ ተወስዷል።"]
  }[f.status] || ["Status updated.","የፋይል ሂደት ተዘምኗል።"];

  document.getElementById("mEng").textContent=alerts[0];
  document.getElementById("mAmh").textContent=alerts[1];

  const idx=Math.max(0,STATUSES.indexOf(f.status));
  document.getElementById("steps").innerHTML=STATUSES.map((s,i)=>
    `<div class="step ${i<idx?"done":i===idx?"active":""}">
      <span class="dot"></span><span>${esc(s)}</span>
    </div>`
  ).join("");

  document.getElementById("qrImage").src=
    "https://api.qrserver.com/v1/create-qr-code/?size=180x180&data="+
    encodeURIComponent(directLink(f));

  document.getElementById("qrName").textContent=f.name;
  document.getElementById("qrRef").textContent=f.receipt;
  document.getElementById("modal").style.display="block";
}

function closeModal(){
  document.getElementById("modal").style.display="none";
}

function shareWhatsApp(){
  const f=filesDatabase[activeReceipt];
  if(!f)return;
  const text =
`*AL NASIR TRACKING*
ስም: ${f.name}
ደረሰኝ: ${f.receipt}
MOFA REF: ${f.mofaRef}
ደረጃ: ${f.status}

ፋይልዎን ለመከታተል:
${directLink(f)}`;

  window.open("https://wa.me/?text="+encodeURIComponent(text),"_blank");
}

async function copyLink(){
  const f=filesDatabase[activeReceipt];
  if(!f)return;

  const link=directLink(f);

  try{
    await navigator.clipboard.writeText(link);
    toast("Tracking link copied!");
  }catch(e){
    window.prompt("Copy this link:",link);
  }
}

/* ============================================================
   ADMIN AUTHENTICATION
   ============================================================ */

async function adminLogin(){
  hideError("loginError");

  if(!db){
    showError("loginError","Supabase is not connected.");
    return;
  }

  const email=document.getElementById("adminEmail").value.trim();
  const password=document.getElementById("adminPassword").value;

  if(!email || !password){
    showError("loginError","Email and password are required.");
    return;
  }

  try{
    const {data,error}=await db.auth.signInWithPassword({email,password});
    if(error) throw error;

    loggedIn=true;
    document.getElementById("adminLogin").style.display="none";
    document.getElementById("adminPanel").style.display="block";
    document.getElementById("adminUser").textContent="Logged in: "+(data.user?.email||email);

    await loadFiles();
    renderAdminFiles();
    toast("Admin login successful");
  }catch(e){
    console.error(e);
    showError("loginError","Login failed: "+(e.message||"Invalid email or password."));
  }
}

async function adminLogout(){
  try{
    if(db) await db.auth.signOut();
  }catch(e){
    console.error(e);
  }

  loggedIn=false;
  document.getElementById("adminLogin").style.display="block";
  document.getElementById("adminPanel").style.display="none";
  document.getElementById("adminPassword").value="";
  toast("Logged out");
}

async function restoreSession(){
  if(!db)return;

  try{
    const {data}=await db.auth.getSession();

    if(data?.session){
      loggedIn=true;
      document.getElementById("adminLogin").style.display="none";
      document.getElementById("adminPanel").style.display="block";
      document.getElementById("adminUser").textContent=
        "Logged in: "+(data.session.user?.email||"Admin");
    }

    db.auth.onAuthStateChange((event,session)=>{
      if(event==="SIGNED_OUT"){
        loggedIn=false;
        document.getElementById("adminLogin").style.display="block";
        document.getElementById("adminPanel").style.display="none";
      }
    });
  }catch(e){
    console.error("Session error:",e);
  }
}

/* ============================================================
   ADMIN DATABASE
   ============================================================ */

function updateOverview(){
  const a=Object.values(filesDatabase);
  document.getElementById("statTotal").textContent=a.length;
  document.getElementById("statEmbassy").textContent=
    a.filter(f=>f.status==="At embassy").length;
  document.getElementById("statReady").textContent=
    a.filter(f=>["Embassy done","Ready to collect"].includes(f.status)).length;
  document.getElementById("statCollected").textContent=
    a.filter(f=>f.status==="Collected").length;
}

function generateReceipt(){
  const year=new Date().getFullYear();
  let receipt;
  do{
    receipt="ATT-"+year+"-"+Math.floor(1000+Math.random()*9000);
  }while(filesDatabase[receipt]);
  document.getElementById("adminReceipt").value=receipt;
}

function clearForm(){
  ["editingReceipt","adminReceipt","adminName","adminPhone","adminType","adminMofa"]
    .forEach(id=>document.getElementById(id).value="");

  document.getElementById("adminStatus").value="Received";
  document.getElementById("formTitle").textContent="Add New File";
}

async function saveFile(){
  if(!db){alert("Database disconnected.");return}

  const old=document.getElementById("editingReceipt").value.trim().toUpperCase();
  const receipt=document.getElementById("adminReceipt").value.trim().toUpperCase();
  const name=document.getElementById("adminName").value.trim();
  const phone=normalizePhone(document.getElementById("adminPhone").value.trim());

  if(!receipt||!name||!phone){
    alert("Receipt, Name and Phone are required.");
    return;
  }

  const payload={
    receipt,
    name,
    phone,
    type:document.getElementById("adminType").value.trim()||"General Document",
    mofa_ref:document.getElementById("adminMofa").value.trim()||"N/A",
    status:document.getElementById("adminStatus").value
  };

  try{
    if(old && old!==receipt){
      const d=await db.from("files").delete().eq("receipt",old);
      if(d.error) throw d.error;
    }

    const {error}=await db.from("files").upsert(payload,{onConflict:"receipt"});
    if(error) throw error;

    clearForm();
    await loadFiles();
    toast("File saved online successfully!");
  }catch(e){
    console.error(e);
    alert("Save failed: "+friendlyDbError(e));
  }
}

function renderAdminFiles(){
  const q=document.getElementById("adminSearch").value.trim().toLowerCase();

  const arr=Object.values(filesDatabase).filter(f=>
    !q ||
    f.name.toLowerCase().includes(q) ||
    f.receipt.toLowerCase().includes(q) ||
    String(f.phone).toLowerCase().includes(q)
  );

  document.getElementById("adminFiles").innerHTML=arr.length
    ? arr.map(f=>`
      <div class="file">
        <div class="receipt">${esc(f.receipt)}</div>
        <div class="name">${esc(f.name)}</div>
        <div class="meta">Phone: ${esc(f.phone)}</div>
        <div class="meta">Status: <span style="color:#10b981">${esc(f.status)}</span></div>
        <div class="two">
          <button class="btn small blue" onclick="editFile('${encodeURIComponent(f.receipt)}')">Edit</button>
          <button class="btn small red" onclick="deleteFile('${encodeURIComponent(f.receipt)}')">Delete</button>
        </div>
      </div>
    `).join("")
    : `<div class="empty">No files found.</div>`;
}

function editFile(encoded){
  const f=filesDatabase[decodeURIComponent(encoded)];
  if(!f)return;

  document.getElementById("editingReceipt").value=f.receipt;
  document.getElementById("adminReceipt").value=f.receipt;
  document.getElementById("adminName").value=f.name;
  document.getElementById("adminPhone").value=f.phone;
  document.getElementById("adminType").value=f.type;
  document.getElementById("adminMofa").value=f.mofaRef==="N/A"?"":f.mofaRef;
  document.getElementById("adminStatus").value=f.status;
  document.getElementById("formTitle").textContent="Edit File: "+f.receipt;

  window.scrollTo({top:0,behavior:"smooth"});
}

async function deleteFile(encoded){
  if(!db)return;

  const receipt=decodeURIComponent(encoded);
  if(!confirm("Delete "+receipt+"?"))return;

  try{
    const {error}=await db.from("files").delete().eq("receipt",receipt);
    if(error)throw error;

    delete filesDatabase[receipt];
    updateOverview();
    renderAdminFiles();
    toast("File deleted online.");
  }catch(e){
    console.error(e);
    alert("Delete failed: "+friendlyDbError(e));
  }
}

/* ============================================================
   REAL-TIME UPDATES
   ============================================================ */

function startRealtime(){
  if(!db)return;

  try{
    if(realtimeChannel) db.removeChannel(realtimeChannel);

    realtimeChannel=db.channel("al-nasir-files-live")
      .on(
        "postgres_changes",
        {event:"*",schema:"public",table:"files"},
        payload=>{
          console.log("Live database change:",payload);
          loadFiles();
          if(activeReceipt && payload.new?.receipt===activeReceipt){
            const updated=makeFile(payload.new);
            filesDatabase[updated.receipt]=updated;
            openLiveTracking(encodeURIComponent(updated.receipt));
          }
        }
      )
      .subscribe();
  }catch(e){
    console.error("Realtime error:",e);
  }
}

/* ============================================================
   KEYBOARD / PAGE EVENTS
   ============================================================ */

document.getElementById("referenceInput").addEventListener("keydown",e=>{
  if(e.key==="Enter")executeSearch();
});

document.getElementById("phoneInput").addEventListener("keydown",e=>{
  if(e.key==="Enter")executeSearch();
});

document.getElementById("adminEmail").addEventListener("keydown",e=>{
  if(e.key==="Enter")adminLogin();
});

document.getElementById("adminPassword").addEventListener("keydown",e=>{
  if(e.key==="Enter")adminLogin();
});

document.getElementById("modal").addEventListener("click",e=>{
  if(e.target.id==="modal")closeModal();
});

window.addEventListener("load",async()=>{
  if(!initSupabase()) return;
  await restoreSession();
  await loadFiles();
  startRealtime();
});
</script>
</body>
</html>
