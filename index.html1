<!DOCTYPE html> 
<html lang="en"> 
<head> 
<meta charset="UTF-8"> 
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"> 
<title>AL NASIR - Live File Tracking & Admin</title> 
<!-- Supabase JS Library -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style> 
*{ box-sizing:border-box; margin:0; padding:0; font-family:-apple-system,BlinkMacSystemFont,sans-serif; } 
body{ background:#030712; color:#fff; min-height:100vh; overflow-x:hidden; } 
.app-container{ width:100%; max-width:480px; min-height:100vh; margin:auto; background:#050a17; box-shadow:0 0 30px rgba(0,0,0,.8); padding-bottom: 20px;} 

/* HEADER */ 
.top-header{ display:flex; justify-content:space-between; align-items:center; padding:16px; background:rgba(5,10,23,.96); position:sticky; top:0; z-index:100; border-bottom:1px solid #1f2937; } 
.logo-area h1{ font-size:1.25rem; letter-spacing:2px; font-weight:800; color:#fff; } 
.logo-area p{ font-size:.5rem; letter-spacing:1px; color:#9ca3af; margin-top:2px; } 

/* TABS */ 
.tabs-container{ padding:16px 16px 0 16px; }
.tabs{ display:grid; grid-template-columns:1fr 1fr; gap:8px; } 
.tab-btn{ padding:12px 8px; background:#0b1329; color:#9ca3af; border:1px solid #1e293b; border-radius:9px; cursor:pointer; font-weight:700; text-align:center; transition:0.3s;} 
.tab-btn.active{ color:#fff; border-color:#059669; background:rgba(5,150,105,.15); } 

/* CONTENT & CARDS */ 
.content{ padding:16px; } 
.card{ background:#070d1e; border:1px solid #1e293b; border-radius:14px; padding:16px; margin-bottom:16px; } 
.card-title{ font-size:1.1rem; font-weight:800; margin-bottom:14px; display:flex; justify-content:space-between; align-items:center; color:#fff; } 

/* FORMS */
.input-label{ display:block; font-size:.65rem; color:#9ca3af; letter-spacing:1px; margin-bottom:6px; } 
.input-field, select{ width:100%; padding:12px; background:#050a17; color:#fff; border:1px solid #1e293b; border-radius:8px; outline:none; margin-bottom:12px; font-size:16px; } 
.input-field:focus, select:focus{ border-color:#059669; } 

/* BUTTONS */
.btn{ width:100%; padding:14px; border:0; border-radius:10px; cursor:pointer; font-weight:700; text-align:center; font-size:0.9rem;} 
.btn-track{ border:1px solid #b45309; background:linear-gradient(90deg,#451a03,#78350f); color:#fff; } 
.btn-track .amh{ color:#fdba74; font-size:.9rem; } 
.btn-track .eng{ color:#f97316; font-size:.72rem; margin-top:3px; } 
.btn-green{ background:#059669; color:white; } 
.btn-dark{ background:#1e293b; color:white; } 
.btn-red{ background:#991b1b; color:white; } 
.btn-blue{ background:#2563eb; color:white; } 
.btn-sm{ padding:8px 12px; font-size:0.75rem; border-radius:6px; width:auto;}
.admin-actions-grid{ display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; } 

/* RESULTS & STATS */ 
#tracking-results, #admin-section, #adminPanel{ display:none; } 
.grid-stats{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:10px;} 
.grid-stats-4{ display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:15px; } 
.stat-box{ background:#0d1527; border:1px solid #1e293b; border-radius:10px; padding:12px; text-align:center; } 
.stat-box.highlight{ border-color:#78350f; background:#120c06; } 
.stat-box.success{ border-color:#059669; background:#041f17; } 
.stat-box .num{ font-size:1.4rem; font-weight:800; color:#fff; } 
.stat-box .label{ color:#9ca3af; font-size:.62rem; font-weight:700; } 

/* LIST CARDS */ 
.file-card{ background:#0a1122; border:1px solid #1f2937; border-radius:12px; padding:16px; margin-bottom:12px; } 
.file-card-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; } 
.badge{ padding:4px 8px; border-radius:6px; font-size:.65rem; font-weight:700; } 
.badge-status{ color:#34d399; border:1px solid #059669; background:rgba(5,150,105,.15); } 
.file-name{ font-size:1rem; font-weight:800; margin-bottom:4px; color:#fff; } 
.meta-text{ color:#9ca3af; font-size:.78rem; margin-bottom:4px; display:flex; }
.meta-text span{ width:85px; color:#6b7280; }
.meta-text strong{ color:#e5e7eb; word-break:break-all; }
.btn-open-live{ margin-top:12px; background:none; border:0; color:#f59e0b; font-weight:700; cursor:pointer; font-size:0.85rem;} 

/* MODAL */ 
.modal-overlay{ display:none; position:fixed; inset:0; background:rgba(3,7,18,.96); z-index:2000; overflow-y:auto; padding:20px 15px; } 
.modal-container{ width:100%; max-width:430px; margin:auto; background:#070d1e; border:1px solid #1e293b; border-radius:16px; padding:20px; position:relative; } 
.close-btn{ position:absolute; right:15px; top:15px; width:32px; height:32px; border:0; border-radius:50%; background:#1f2937; color:#fff; font-size:1.2rem; cursor:pointer; } 
.stepper-list{ display:flex; flex-direction:column; gap:8px; margin:20px 0; } 
.step-item{ display:flex; align-items:center; gap:12px; padding:12px; background:#0b1329; border:1px solid #1e293b; border-radius:9px; color:#6b7280; font-size:.85rem; } 
.step-item.active{ border-color:#059669; background:rgba(5,150,105,.1); color:#fff; font-weight:bold;} 
.step-item.completed{ border-color:#78350f; color:#d1d5db; } 
.step-dot{ width:14px; height:14px; border-radius:50%; background:#374151; flex:none; } 
.step-item.active .step-dot{ background:#10b981; box-shadow:0 0 10px #10b981; } 
.step-item.completed .step-dot{ background:#d97706; } 

/* QR */
.qr-section{ background:#0b1329; border:1px solid #1f2937; border-radius:12px; padding:16px; text-align:center; margin-bottom:15px; } 
.qr-image{ width:150px; height:150px; background:#fff; padding:6px; border-radius:8px; margin:0 auto 10px; display:block; } 

/* TOAST */ 
.toast-message{ position:fixed; bottom:25px; left:50%; transform:translate(-50%, 80px); background:#059669; color:#fff; padding:12px 20px; border-radius:25px; font-size:.85rem; font-weight:bold; opacity:0; transition:0.3s; z-index:5000; white-space:nowrap; } 
.toast-message.show{ transform:translate(-50%, 0); opacity:1; } 
</style> 
</head> 
<body> 
<div class="app-container"> 
  <!-- Header -->
  <header class="top-header"> 
    <div class="logo-area"> 
      <h1>AL NASIR</h1> 
      <p>COMMISSION & TRAVEL AGENT</p> 
    </div> 
  </header> 

  <!-- Global Tabs -->
  <div class="tabs-container">
    <div class="tabs"> 
      <button class="tab-btn active" id="tabTrack" onclick="switchTab('track')">Track Files</button> 
      <button class="tab-btn" id="tabAdmin" onclick="switchTab('admin')">Admin Panel</button> 
    </div>
  </div>

  <div class="content"> 
    <!-- ================= TRACK SECTION ================= --> 
    <section id="track-section" style="display:block;"> 
      
      <!-- Search Box -->
      <div class="card"> 
        <div class="card-title"> Search Application </div> 
        <label class="input-label">RECEIPT NUMBER (ደረሰኝ)</label> 
        <input id="referenceInput" class="input-field" type="text" placeholder="ATT-2026-..." > 
        
        <label class="input-label">MOBILE NUMBER (ስልክ)</label> 
        <input id="phoneInput" class="input-field" type="tel" placeholder="09xxxxxxxx" > 
        
        <button class="btn btn-track" onclick="executeSearch()"> 
          <div class="amh">የፋይሎችዎን ሂደት ይከታተሉ</div> 
          <div class="eng">TRACK PROGRESS</div> 
        </button> 
      </div> 

      <!-- Search Results -->
      <div id="tracking-results"> 
        <div class="card"> 
          <div class="card-title" style="margin-bottom:5px;"> 
            <span><span id="totalFilesCount">0</span> Files Found</span>
          </div> 
          <div style="color:#9ca3af; font-size:.85rem; margin-bottom:10px;" id="displayPhone"></div> 
          <div class="grid-stats"> 
            <div class="stat-box"> 
              <div class="num" id="embassyCount">0</div> 
              <div class="label">AT EMBASSY</div> 
            </div> 
            <div class="stat-box highlight"> 
              <div class="num" id="attestedCount">0</div> 
              <div class="label">READY/DONE</div> 
            </div> 
          </div> 
        </div> 
        <div id="fileCardsList"></div> 
      </div> 
    </section> 

    <!-- ================= ADMIN SECTION ================= --> 
    <section id="admin-section"> 
      
      <!-- Admin Login -->
      <div id="adminLogin" class="card" style="text-align:center; padding:30px 16px;"> 
        <h2 style="margin-bottom:20px; color:#fff;">Admin Login</h2> 
        <label class="input-label" style="text-align:left;">PASSWORD</label> 
        <input id="adminPassword" class="input-field" type="password" placeholder="Enter password (1234)"> 
        <button class="btn btn-green" onclick="adminLogin()"> Secure Login </button> 
      </div> 

      <!-- Admin Dashboard (Hidden until login) -->
      <div id="adminPanel"> 
        
        <!-- Stats -->
        <div class="card">
          <div class="card-title">System Overview</div>
          <div class="grid-stats-4">
            <div class="stat-box"><div class="num" id="statTotal">0</div><div class="label">TOTAL</div></div>
            <div class="stat-box"><div class="num" id="statEmbassy">0</div><div class="label">EMBASSY</div></div>
            <div class="stat-box highlight"><div class="num" id="statReady">0</div><div class="label">READY</div></div>
            <div class="stat-box success"><div class="num" id="statCollected">0</div><div class="label">COLLECTED</div></div>
          </div>
        </div>

        <!-- Add/Edit Form -->
        <div class="card"> 
          <div class="card-title">
            <span id="formTitle">Add New File</span>
            <button class="btn-sm btn-blue" onclick="generateRandomReceipt()">Auto Ref</button>
          </div> 
          
          <input type="hidden" id="editingReceiptKey" value="">
          
          <label class="input-label">RECEIPT NUMBER *</label> 
          <input id="adminReceipt" class="input-field" placeholder="ATT-2026-0001"> 
          
          <label class="input-label">CUSTOMER NAME *</label> 
          <input id="adminName" class="input-field" placeholder="Full name"> 
          
          <label class="input-label">PHONE NUMBER *</label> 
          <input id="adminPhone" class="input-field" type="tel" placeholder="0900000000"> 
          
          <label class="input-label">DOCUMENT TYPE</label> 
          <input id="adminType" class="input-field" placeholder="e.g. Police clearance"> 
          
          <label class="input-label">MOFA REFERENCE</label> 
          <input id="adminMofa" class="input-field" placeholder="ATS-2026..."> 
          
          <label class="input-label">STATUS</label> 
          <select id="adminStatus"> 
            <option value="Received">Received (ተቀብለናል)</option> 
            <option value="At embassy">At embassy (ኤምባሲ ገብቷል)</option> 
            <option value="Embassy done">Embassy done (ኤምባሲ አልቋል)</option> 
            <option value="Ready to collect">Ready to collect (ለመውሰድ ዝግጁ)</option> 
            <option value="Collected">Collected (ተወስዷል)</option> 
          </select> 
          
          <div class="admin-actions-grid"> 
            <button class="btn btn-green" onclick="saveFile()"> Save File </button> 
            <button class="btn btn-dark" onclick="clearAdminForm()"> Clear </button> 
          </div> 
        </div> 

        <!-- File List & Search -->
        <div class="card"> 
          <div class="card-title"> Database Management </div> 
          <input id="adminSearchInput" class="input-field" placeholder="Search by name or receipt..." oninput="renderAdminFiles()">
          <div id="adminFilesList"></div> 
        </div> 

        <button class="btn btn-red" style="margin-bottom:20px" onclick="adminLogout()" > Logout </button> 
      </div> 
    </section> 
  </div> 
</div> 

<!-- ================= MODAL: LIVE TRACKING ================= --> 
<div class="modal-overlay" id="trackingModal"> 
  <div class="modal-container"> 
    <button class="close-btn" onclick="closeLiveTracking()">✕</button> 
    
    <div style="color:#6b7280; font-size:.7rem; font-weight:700;">AL NASIR TRACKING</div> 
    <div style="font-size:1.6rem; font-weight:800; color:#fff; margin-bottom:5px;" id="mStatusTitle"> At embassy </div> 
    <div style="color:#f59e0b; font-size:.9rem; font-weight:bold; margin-bottom:15px;" id="mReceipt"> Receipt </div> 
    
    <div class="meta-text"><span>Customer:</span> <strong id="mCustomerName"></strong></div> 
    <div class="meta-text"><span>Phone:</span> <strong id="mCustomerPhone"></strong></div> 
    <div class="meta-text"><span>MOFA REF:</span> <strong id="mMofaRef"></strong></div> 
    
    <!-- Amharic / English Alert -->
    <div style="background:rgba(6,78,59,.4); border:1px solid #059669; border-radius:10px; padding:12px; margin:15px 0;"> 
      <div style="color:#6ee7b7; font-size:.8rem; margin-bottom:4px;" id="mAlertEng"></div> 
      <div style="font-size:.85rem; font-weight:700; color:#fff;" id="mAlertAmh"></div> 
    </div> 
    
    <!-- Stepper -->
    <div class="stepper-list" id="mStepper"></div> 
    
    <!-- QR Code -->
    <div class="qr-section"> 
      <img id="mQrImage" class="qr-image" alt="QR Code"> 
      <div style="font-weight:bold; font-size:.9rem; color:#fff;" id="mQrName"></div> 
      <div style="color:#9ca3af; font-size:.8rem; margin-top:4px" id="mQrRef"></div> 
    </div> 
    
    <button class="btn btn-green" style="margin-bottom:10px;" onclick="shareOnWhatsApp()"> Share via WhatsApp </button> 
  </div> 
</div> 

<!-- TOAST MESSAGE -->
<div id="toast" class="toast-message">Action completed</div>

<script> 
/* --- SUPABASE CONFIGURATION --- */
const SUPABASE_URL = "https://cxlaebwiibzvedaupmtr.supabase.co"; 
const SUPABASE_KEY = "Sb_publishable_wwJIy_f5u8ZKYYKi1w87aA_CVHt_7O"; 

const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

let filesDatabase = {}; 
let activeFileReceipt = null; 
let isAdminLoggedIn = false;

// 1. Fetch All Data from Supabase
async function fetchAllFiles() {
  try {
    const { data, error } = await _supabase.from('files').select('*');
    if (error) throw error;

    filesDatabase = {};
    if (data) {
      data.forEach(item => {
        filesDatabase[item.receipt] = {
          receipt: item.receipt,
          name: item.name,
          phone: item.phone,
          type: item.type || "General Document",
          status: item.status || "Received",
          mofaRef: item.mofa_ref || "N/A"
        };
      });
    }
    updateAdminOverview();
    if(isAdminLoggedIn) renderAdminFiles();
  } catch (err) {
    console.error("Error fetching data:", err);
  }
}

// Load data immediately on startup
fetchAllFiles();

function showToast(msg) {
  const toast = document.getElementById("toast");
  toast.innerText = msg;
  toast.classList.add("show");
  setTimeout(() => toast.classList.remove("show"), 3000);
}

/* --- TAB SWITCHING --- */
function switchTab(tabName) {
  if (tabName === 'track') {
    document.getElementById("track-section").style.display = "block";
    document.getElementById("admin-section").style.display = "none";
    document.getElementById("tabTrack").classList.add("active");
    document.getElementById("tabAdmin").classList.remove("active");
  } else {
    document.getElementById("track-section").style.display = "none";
    document.getElementById("admin-section").style.display = "block";
    document.getElementById("tabAdmin").classList.add("active");
    document.getElementById("tabTrack").classList.remove("active");
  }
}

/* --- USER TRACKING --- */ 
async function executeSearch(){ 
  const ref = document.getElementById("referenceInput").value.trim().toUpperCase(); 
  const phone = document.getElementById("phoneInput").value.trim(); 

  if(!ref && !phone){ 
    alert("እባክዎ ደረሰኝ ወይም ስልክ ቁጥር ያስገቡ! (Enter Receipt or Phone)"); 
    return; 
  } 

  // Make sure we have latest online data
  await fetchAllFiles();

  let results = []; 
  Object.values(filesDatabase).forEach(file => { 
    if(ref && file.receipt.toUpperCase() === ref){ 
      results.push(file); 
    } else if(!ref && phone && (file.phone === phone || file.phone.includes(phone))){ 
      results.push(file); 
    } 
  }); 

  if(results.length === 0){ 
    document.getElementById("tracking-results").style.display = "none"; 
    alert("ምንም ፋይል አልተገኘም! (No application found.)"); 
    return; 
  } 

  document.getElementById("tracking-results").style.display = "block"; 
  document.getElementById("displayPhone").innerText = "Phone: " + (phone || results[0].phone); 
  document.getElementById("totalFilesCount").innerText = results.length; 

  let embassy = 0, attested = 0; 
  results.forEach(file => { 
    if(file.status === "At embassy" || file.status === "Received") embassy++; 
    if(["Embassy done", "Ready to collect", "Collected"].includes(file.status)) attested++; 
  }); 

  document.getElementById("embassyCount").innerText = embassy; 
  document.getElementById("attestedCount").innerText = attested; 

  const container = document.getElementById("fileCardsList"); 
  container.innerHTML = ""; 
  results.forEach(file => { 
    container.innerHTML += ` 
    <div class="file-card"> 
      <div class="file-card-top"> 
        <span style="color:#f59e0b; font-weight:bold;"> ${file.receipt} </span> 
        <span class="badge badge-status"> ${file.status.toUpperCase()} </span> 
      </div> 
      <div class="file-name"> ${file.name} </div> 
      <div class="meta-text"><span>Type:</span> <strong>${file.type || 'N/A'}</strong></div> 
      <div class="meta-text"><span>MOFA Ref:</span> <strong>${file.mofaRef || 'N/A'}</strong></div> 
      <button class="btn-open-live" onclick="openLiveTracking('${file.receipt}')"> Open Live Tracking → </button> 
    </div> `; 
  }); 
} 

/* --- MODAL LOGIC --- */ 
function openLiveTracking(receipt){ 
  const file = filesDatabase[receipt]; 
  if(!file) return; 

  activeFileReceipt = file.receipt; 
  document.getElementById("mStatusTitle").innerText = file.status; 
  document.getElementById("mReceipt").innerText = file.receipt; 
  document.getElementById("mMofaRef").innerText = file.mofaRef || "N/A";
  document.getElementById("mCustomerName").innerText = file.name;
  document.getElementById("mCustomerPhone").innerText = file.phone;

  let alertEng = "", alertAmh = "";
  if(file.status === "Received") {
    alertEng = "File received at office."; alertAmh = "ፋይልዎ በቢሮአችን ተቀብለናል።";
  } else if(file.status === "At embassy") {
    alertEng = "Submitted to embassy."; alertAmh = "ፋይልዎ ወደ ኤምባሲ ገብቷል።";
  } else if(file.status === "Embassy done") {
    alertEng = "Attestation complete at embassy."; alertAmh = "በኤምባሲ ማረጋገጫ ተጠናቋል።";
  } else if(file.status === "Ready to collect") {
    alertEng = "Document is ready for pickup!"; alertAmh = "ሰነድዎ ለማንሳት ዝግጁ ነው!";
  } else if(file.status === "Collected") {
    alertEng = "Document collected."; alertAmh = "ሰነዱ ተወስዷል።";
  }

  document.getElementById("mAlertEng").innerText = alertEng;
  document.getElementById("mAlertAmh").innerText = alertAmh;

  const steps = ["Received", "At embassy", "Embassy done", "Ready to collect", "Collected"];
  const currIdx = steps.indexOf(file.status);
  let stepperHtml = "";

  steps.forEach((st, idx) => {
    let cls = "";
    if(idx < currIdx) cls = "completed";
    else if(idx === currIdx) cls = "active";
    stepperHtml += `
      <div class="step-item ${cls}">
        <div class="step-dot"></div>
        <div>${st}</div>
      </div>
    `;
  });
  document.getElementById("mStepper").innerHTML = stepperHtml;

  const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(file.receipt)}`;
  document.getElementById("mQrImage").src = qrUrl;
  document.getElementById("mQrName").innerText = file.name;
  document.getElementById("mQrRef").innerText = file.receipt;

  document.getElementById("trackingModal").style.display = "block";
} 

function closeLiveTracking(){
  document.getElementById("trackingModal").style.display = "none";
}

function shareOnWhatsApp() {
  if(!activeFileReceipt) return;
  const file = filesDatabase[activeFileReceipt];
  const text = `*AL NASIR TRACKING*\nName: ${file.name}\nReceipt: ${file.receipt}\nStatus: ${file.status}\nMOFA: ${file.mofaRef}`;
  window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
}

/* --- ADMIN LOGIC --- */
function adminLogin(){
  const pass = document.getElementById("adminPassword").value;
  if(pass === "1234" || pass === "admin") {
    isAdminLoggedIn = true;
    document.getElementById("adminLogin").style.display = "none";
    document.getElementById("adminPanel").style.display = "block";
    fetchAllFiles();
    showToast("Logged in as Admin");
  } else {
    alert("Incorrect password!");
  }
}

function adminLogout(){
  isAdminLoggedIn = false;
  document.getElementById("adminLogin").style.display = "block";
  document.getElementById("adminPanel").style.display = "none";
  document.getElementById("adminPassword").value = "";
}

function updateAdminOverview(){
  let total = 0, embassy = 0, ready = 0, collected = 0;
  Object.values(filesDatabase).forEach(f => {
    total++;
    if(f.status === "At embassy") embassy++;
    if(["Ready to collect", "Embassy done"].includes(f.status)) ready++;
    if(f.status === "Collected") collected++;
  });
  document.getElementById("statTotal").innerText = total;
  document.getElementById("statEmbassy").innerText = embassy;
  document.getElementById("statReady").innerText = ready;
  document.getElementById("statCollected").innerText = collected;
}

function generateRandomReceipt(){
  const num = Math.floor(1000 + Math.random() * 9000);
  document.getElementById("adminReceipt").value = `ATT-2026-${num}`;
}

function clearAdminForm(){
  document.getElementById("editingReceiptKey").value = "";
  document.getElementById("adminReceipt").value = "";
  document.getElementById("adminName").value = "";
  document.getElementById("adminPhone").value = "";
  document.getElementById("adminType").value = "";
  document.getElementById("adminMofa").value = "";
  document.getElementById("adminStatus").value = "Received";
  document.getElementById("formTitle").innerText = "Add New File";
}

// 2. Save / Update File in Supabase
async function saveFile(){
  const editKey = document.getElementById("editingReceiptKey").value;
  const receipt = document.getElementById("adminReceipt").value.trim().toUpperCase();
  const name = document.getElementById("adminName").value.trim();
  const phone = document.getElementById("adminPhone").value.trim();

  if(!receipt || !name || !phone) {
    alert("Please fill Receipt, Name, and Phone.");
    return;
  }

  const payload = {
    receipt: receipt,
    name: name,
    phone: phone,
    type: document.getElementById("adminType").value.trim() || "General Document",
    mofa_ref: document.getElementById("adminMofa").value.trim() || "N/A",
    status: document.getElementById("adminStatus").value
  };

  try {
    if (editKey && editKey !== receipt) {
      // If receipt number was changed, delete old and insert new
      await _supabase.from('files').delete().eq('receipt', editKey);
    }

    const { error } = await _supabase.from('files').upsert([payload]);
    if (error) throw error;

    await fetchAllFiles();
    clearAdminForm();
    showToast("File Saved Online Successfully!");
  } catch (err) {
    alert(" Error saving file to database: " + err.message);
  }
}

function renderAdminFiles(){
  const query = document.getElementById("adminSearchInput").value.toLowerCase();
  const list = document.getElementById("adminFilesList");
  list.innerHTML = "";

  Object.values(filesDatabase).forEach(file => {
    if(query && !file.name.toLowerCase().includes(query) && !file.receipt.toLowerCase().includes(query)){
      return;
    }
    list.innerHTML += `
      <div class="file-card" style="background:#0b1329;">
        <div style="color:#f59e0b; font-weight:bold; margin-bottom:4px;">${file.receipt}</div>
        <div style="font-weight:bold; color:#fff;">${file.name}</div>
        <div style="color:#9ca3af; font-size:0.8rem; margin:4px 0;">Phone: ${file.phone} | Status: <span style="color:#10b981;">${file.status}</span></div>
        <div class="admin-actions-grid">
          <button class="btn btn-sm btn-blue" onclick="editFile('${file.receipt}')">Edit</button>
          <button class="btn btn-sm btn-red" onclick="deleteFile('${file.receipt}')">Delete</button>
        </div>
      </div>
    `;
  });
}

function editFile(receipt){
  const file = filesDatabase[receipt];
  if(!file) return;

  document.getElementById("editingReceiptKey").value = file.receipt;
  document.getElementById("adminReceipt").value = file.receipt;
  document.getElementById("adminName").value = file.name;
  document.getElementById("adminPhone").value = file.phone;
  document.getElementById("adminType").value = file.type || "";
  document.getElementById("adminMofa").value = file.mofaRef || "";
  document.getElementById("adminStatus").value = file.status;

  document.getElementById("formTitle").innerText = "Edit File: " + file.receipt;
  window.scrollTo({top: 0, behavior: 'smooth'});
}

// 3. Delete File from Supabase
async function deleteFile(receipt){
  if(confirm("Are you sure you want to delete this file? (እርግጠኛ ነዎት ይህን ፋይል ማጥፋት ይፈልጋሉ?)")){
    try {
      const { error } = await _supabase.from('files').delete().eq('receipt', receipt);
      if (error) throw error;

      await fetchAllFiles();
      showToast("File deleted online.");
    } catch(err) {
      alert("Error deleting file: " + err.message);
    }
  }
}
</script> 
</body> 
</html>
