<!DOCTYPE html>
<html lang="am">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<meta name="theme-color" content="#030712">
<meta name="description" content="AL NASIR Live File Tracking & Admin">
<title>AL NASIR - Live File Tracking & Admin</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
body{background:#030712;color:#fff;min-height:100vh;overflow-x:hidden}
.app{width:100%;max-width:500px;min-height:100vh;margin:auto;background:#050a17;padding-bottom:30px}
header{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:15px 16px;background:rgba(5,10,23,.97);border-bottom:1px solid #1f2937}
.logo h1{font-size:1.25rem;letter-spacing:2px}.logo p{font-size:.55rem;color:#9ca3af;letter-spacing:1px;margin-top:2px}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:16px 16px 0}
.tab{padding:12px 8px;border:1px solid #1e293b;border-radius:9px;background:#0b1329;color:#9ca3af;font-weight:700;cursor:pointer}
.tab.active{color:#fff;border-color:#059669;background:rgba(5,150,105,.15)}
.content{padding:16px}.card,.file{background:#070d1e;border:1px solid #1e293b;border-radius:14px;padding:16px;margin-bottom:16px}
.title{font-size:1.05rem;font-weight:800;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
label{display:block;font-size:.65rem;color:#9ca3af;letter-spacing:1px;margin:0 0 6px}
input,select{width:100%;padding:12px;background:#050a17;color:#fff;border:1px solid #1e293b;border-radius:8px;outline:0;margin-bottom:12px;font-size:16px}
input:focus,select:focus{border-color:#059669}
button{cursor:pointer}.btn{width:100%;padding:13px;border:0;border-radius:9px;font-weight:700;font-size:.9rem}
.track{border:1px solid #b45309;background:linear-gradient(90deg,#451a03,#78350f);color:#fff}.track .am{color:#fdba74}.track .en{font-size:.72rem;color:#f97316;margin-top:3px}
.green{background:#059669;color:#fff}.dark{background:#1e293b;color:#fff}.red{background:#991b1b;color:#fff}.blue{background:#2563eb;color:#fff}.orange{background:#d97706;color:#fff}
.small{width:auto;padding:8px 12px;font-size:.75rem}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:10px}
.stat{background:#0d1527;border:1px solid #1e293b;border-radius:10px;padding:12px;text-align:center}.stat b{display:block;font-size:1.35rem}.stat span{font-size:.62rem;color:#9ca3af;font-weight:700}
.file{background:#0a1122}.filetop{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:8px}.receipt{color:#f59e0b;font-weight:800}.badge{padding:4px 7px;border:1px solid #059669;border-radius:6px;color:#34d399;background:rgba(5,150,105,.15);font-size:.62rem;font-weight:700}
.name{font-weight:800;margin-bottom:5px}.meta{color:#9ca3af;font-size:.78rem;margin:4px 0}.meta b{display:inline-block;width:85px;color:#6b7280}
#trackResults,#adminSection,#adminPanel{display:none}.searchHint{color:#9ca3af;font-size:.78rem;margin-top:8px}
.modal{display:none;position:fixed;inset:0;z-index:1000;background:rgba(3,7,18,.97);overflow:auto;padding:18px 14px}.modalbox{max-width:450px;margin:auto;background:#070d1e;border:1px solid #1e293b;border-radius:16px;padding:20px;position:relative}.close{position:absolute;right:12px;top:12px;border:0;background:#1f2937;color:#fff;width:32px;height:32px;border-radius:50%;font-size:18px}
.steps{display:grid;gap:7px;margin:18px 0}.step{display:flex;gap:10px;align-items:center;padding:11px;background:#0b1329;border:1px solid #1e293b;border-radius:8px;color:#6b7280;font-size:.84rem}.dot{width:13px;height:13px;border-radius:50%;background:#374151;flex:none}.step.active{border-color:#059669;color:#fff;font-weight:700}.step.active .dot{background:#10b981;box-shadow:0 0 9px #10b981}.step.done{border-color:#78350f;color:#d1d5db}.step.done .dot{background:#d97706}
.qr{background:#0b1329;border:1px solid #1f2937;border-radius:11px;padding:15px;text-align:center;margin-bottom:12px}.qr img{width:150px;height:150px;background:#fff;padding:5px;border-radius:8px}
.toast{position:fixed;left:50%;bottom:22px;z-index:2000;transform:translate(-50%,80px);opacity:0;background:#059669;padding:11px 18px;border-radius:25px;font-weight:700;font-size:.82rem;transition:.25s;white-space:nowrap}.toast.show{transform:translate(-50%,0);opacity:1}
.empty{color:#9ca3af;text-align:center;padding:15px;font-size:.85rem}
.note{font-size:.72rem;color:#9ca3af;line-height:1.5}
</style>
</head>
<body>
<div class="app">
<header><div class="logo"><h1>AL NASIR</h1><p>COMMISSION & TRAVEL AGENT</p></div></header>

<div class="tabs">
<button class="tab active" id="tabTrack" onclick="switchTab('track')">Track Files</button>
<button class="tab" id="tabAdmin" onclick="switchTab('admin')">Admin Panel</button>
</div>

<main class="content">
<section id="trackSection">
<div class="card">
<div class="title">Search Application</div>
<label>RECEIPT NUMBER (ደረሰኝ)</label>
<input id="referenceInput" placeholder="ATT-2026-0001" autocomplete="off">
<label>MOBILE NUMBER (ስልክ)</label>
<input id="phoneInput" type="tel" inputmode="tel" placeholder="09xxxxxxxx" autocomplete="tel">
<button class="btn track" onclick="executeSearch()"><div class="am">የፋይሎችዎን ሂደት ይከታተሉ</div><div class="en">TRACK PROGRESS</div></button>
<div class="searchHint">Receipt ወይም phone በመጠቀም ፋይልዎን ይፈልጉ።</div>
</div>

<div id="trackResults">
<div class="card">
<div class="title"><span><b id="totalFiles">0</b> Files Found</span></div>
<div id="displayPhone" style="color:#9ca3af;font-size:.82rem"></div>
<div class="stats">
<div class="stat"><b id="embassyCount">0</b><span>AT EMBASSY</span></div>
<div class="stat"><b id="readyCount">0</b><span>READY / DONE</span></div>
</div>
</div>
<div id="fileList"></div>
</div>
</section>

<section id="adminSection">
<div id="adminLogin" class="card" style="text-align:center">
<div class="title">Admin Login</div>
<label style="text-align:left">PASSWORD</label>
<input id="adminPassword" type="password" placeholder="Enter admin password">
<button class="btn green" onclick="adminLogin()">Secure Login</button>
<p class="note" style="margin-top:10px">For production, use Supabase Auth instead of a browser-only password.</p>
</div>

<div id="adminPanel">
<div class="card">
<div class="title">System Overview</div>
<div class="stats">
<div class="stat"><b id="statTotal">0</b><span>TOTAL</span></div>
<div class="stat"><b id="statEmbassy">0</b><span>EMBASSY</span></div>
<div class="stat"><b id="statReady">0</b><span>READY</span></div>
<div class="stat"><b id="statCollected">0</b><span>COLLECTED</span></div>
</div>
</div>

<div class="card">
<div class="title"><span id="formTitle">Add New File</span><button class="btn small blue" onclick="generateReceipt()">Auto Ref</button></div>
<input type="hidden" id="editingReceipt">
<label>RECEIPT NUMBER *</label><input id="adminReceipt" placeholder="ATT-2026-0001">
<label>CUSTOMER NAME *</label><input id="adminName" placeholder="Full name">
<label>PHONE NUMBER *</label><input id="adminPhone" type="tel" placeholder="0900000000">
<label>DOCUMENT TYPE</label><input id="adminType" placeholder="Police clearance">
<label>MOFA REFERENCE</label><input id="adminMofa" placeholder="ATS-2026...">
<label>STATUS</label>
<select id="adminStatus">
<option>Received</option><option>At embassy</option><option>Embassy done</option><option>Ready to collect</option><option>Collected</option>
</select>
<div class="two"><button class="btn green" onclick="saveFile()">Save File</button><button class="btn dark" onclick="clearForm()">Clear</button></div>
</div>

<div class="card">
<div class="title">Database Management</div>
<input id="adminSearch" placeholder="Search name or receipt..." oninput="renderAdminFiles()">
<div id="adminFiles"></div>
</div>
<button class="btn red" onclick="adminLogout()">Logout</button>
</div>
</section>
</main>
</div>

<div class="modal" id="modal">
<div class="modalbox">
<button class="close" onclick="closeModal()">✕</button>
<div style="color:#6b7280;font-size:.7rem;font-weight:700">AL NASIR LIVE TRACKING</div>
<h2 id="mStatus" style="margin:5px 0;color:#fff">Status</h2>
<div id="mReceipt" style="color:#f59e0b;font-weight:800;margin-bottom:14px"></div>
<div class="meta"><b>Customer:</b><span id="mName"></span></div>
<div class="meta"><b>Phone:</b><span id="mPhone"></span></div>
<div class="meta"><b>MOFA REF:</b><span id="mMofa"></span></div>
<div style="background:rgba(6,78,59,.4);border:1px solid #059669;border-radius:9px;padding:11px;margin:14px 0">
<div id="mEng" style="color:#6ee7b7;font-size:.8rem"></div><div id="mAmh" style="font-weight:700;font-size:.85rem;margin-top:3px"></div>
</div>
<div class="steps" id="steps"></div>
<div class="qr"><img id="qrImage" alt="Tracking QR"><div id="qrName" style="font-weight:700;margin-top:7px"></div><div id="qrRef" style="color:#9ca3af;font-size:.78rem"></div></div>
<div class="two"><button class="btn green" onclick="shareWhatsApp()">WhatsApp</button><button class="btn orange" onclick="copyLink()">Copy Link</button></div>
</div>
</div>
<div class="toast" id="toast">Done</div>

<script>
/* ============================================================
   1) SUPABASE CONFIG
   ============================================================ */
const SUPABASE_URL = "https://cxlaebwiibzvedaupmtr.supabase.co";
const SUPABASE_KEY = "Sb_publishable_wwJIy_f5u8ZKYYKi1w87aA_CVHt_7Ou";

const ADMIN_PASSWORD = "1234"; 
const db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

let filesDatabase = {};
let activeReceipt = null;
let loggedIn = false;
let loading = false;

const STATUSES = ["Received","At embassy","Embassy done","Ready to collect","Collected"];

function esc(v){
  return String(v ?? "").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
}
function normalizePhone(v){
  let p=String(v||"").replace(/[^\d+]/g,"");
  if(p.startsWith("+251")) return "0"+p.slice(4);
  if(p.startsWith("251")) return "0"+p.slice(3);
  return p;
}
function toast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),2500)}
function switchTab(t){
  const track=t==="track";
  document.getElementById("trackSection").style.display=track?"block":"none";
  document.getElementById("adminSection").style.display=track?"none":"block";
  document.getElementById("tabTrack").classList.toggle("active",track);
  document.getElementById("tabAdmin").classList.toggle("active",!track);
}
function makeFile(row){
  return {receipt:row.receipt,name:row.name,phone:row.phone,type:row.type||"General Document",mofaRef:row.mofa_ref||"N/A",status:row.status||"Received"};
}
async function fetchAllFiles(){
  if(loading)return;
  loading=true;
  try{
    const {data,error}=await db.from("files").select("*").order("receipt",{ascending:false});
    if(error)throw error;
    filesDatabase={};
    (data||[]).forEach(r=>{if(r.receipt)filesDatabase[r.receipt]=makeFile(r)});
    updateOverview();
    if(loggedIn)renderAdminFiles();
    checkUrl();
  }catch(e){
    console.error(e);
    if(!String(e.message||"").toLowerCase().includes("failed to fetch"))
      toast("Database error: "+(e.message||"Check Supabase settings"));
  }finally{loading=false}
}
function checkUrl(){
  const q=new URLSearchParams(location.search), ref=q.get("ref"), phone=q.get("phone");
  if(ref){
    document.getElementById("referenceInput").value=ref;
    const key=ref.toUpperCase();
    if(filesDatabase[key]){executeSearch();openLiveTracking(key)}
    else executeSearch();
  }else if(phone){
    document.getElementById("phoneInput").value=phone;executeSearch();
  }
}
async function executeSearch(){
  const ref=document.getElementById("referenceInput").value.trim().toUpperCase();
  const phone=normalizePhone(document.getElementById("phoneInput").value.trim());
  if(!ref&&!phone){alert("እባክዎ ደረሰኝ ወይም ስልክ ቁጥር ያስገቡ!");return}
  let results=Object.values(filesDatabase).filter(f=>{
    if(ref)return f.receipt.toUpperCase()===ref;
    return normalizePhone(f.phone)===phone;
  });
  if(!results.length){document.getElementById("trackResults").style.display="none";alert("ምንም ፋይል አልተገኘም! (No application found.)");return}
  document.getElementById("trackResults").style.display="block";
  document.getElementById("totalFiles").textContent=results.length;
  document.getElementById("displayPhone").textContent="Phone: "+(phone||results[0].phone);
  document.getElementById("embassyCount").textContent=results.filter(f=>["Received","At embassy"].includes(f.status)).length;
  document.getElementById("readyCount").textContent=results.filter(f=>["Embassy done","Ready to collect","Collected"].includes(f.status)).length;
  document.getElementById("fileList").innerHTML=results.map(f=>`
    <div class="file">
      <div class="filetop"><span class="receipt">${esc(f.receipt)}</span><span class="badge">${esc(f.status.toUpperCase())}</span></div>
      <div class="name">${esc(f.name)}</div>
      <div class="meta"><b>Type:</b>${esc(f.type)}</div>
      <div class="meta"><b>MOFA Ref:</b>${esc(f.mofaRef)}</div>
      <button class="btn-open-live" style="margin-top:10px;background:none;border:0;color:#f59e0b;font-weight:700" onclick="openLiveTracking('${encodeURIComponent(f.receipt)}')">Open Live Tracking →</button>
    </div>`).join("");
}
function directLink(file){return `${location.origin}${location.pathname}?ref=${encodeURIComponent(file.receipt)}`}
function openLiveTracking(encoded){
  const receipt=decodeURIComponent(encoded), f=filesDatabase[receipt];
  if(!f)return;
  activeReceipt=f.receipt;
  document.getElementById("mStatus").textContent=f.status;
  document.getElementById("mReceipt").textContent=f.receipt;
  document.getElementById("mName").textContent=f.name;
  document.getElementById("mPhone").textContent=f.phone;
  document.getElementById("mMofa").textContent=f.mofaRef;
  const alerts={
    "Received":["File received at office.","ፋይልዎ በቢሮአችን ተቀብለናል።"],
    "At embassy":["Submitted to embassy.","ፋይልዎ ወደ ኤምባሲ ገብቷል።"],
    "Embassy done":["Attestation complete at embassy.","በኤምባሲ ማረጋገጫ ተጠናቋል።"],
    "Ready to collect":["Document is ready for pickup!","ሰነድዎ ለማንሳት ዝግጁ ነው!"],
    "Collected":["Document collected.","ሰነዱ ተወስዷል።"]
  }[f.status]||["Status updated.","የፋይል ሂደት ተዘምኗል።"];
  document.getElementById("mEng").textContent=alerts[0];document.getElementById("mAmh").textContent=alerts[1];
  const idx=STATUSES.indexOf(f.status);
  document.getElementById("steps").innerHTML=STATUSES.map((s,i)=>`<div class="step ${i<idx?"done":i===idx?"active":""}"><span class="dot"></span><span>${s}</span></div>`).join("");
  document.getElementById("qrImage").src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data="+encodeURIComponent(directLink(f));
  document.getElementById("qrName").textContent=f.name;document.getElementById("qrRef").textContent=f.receipt;
  document.getElementById("modal").style.display="block";
}
function closeModal(){document.getElementById("modal").style.display="none"}
function shareWhatsApp(){
  const f=filesDatabase[activeReceipt];if(!f)return;
  const text=`*AL NASIR TRACKING*%0Aስም: ${f.name}%0Aደረሰኝ: ${f.receipt}%0Aደረጃ: ${f.status}%0A%0Aፋይልዎን ለመከታተል:%0A${directLink(f)}`;
  location.href="https://wa.me/?text="+text;
}
async function copyLink(){
  const f=filesDatabase[activeReceipt];if(!f)return;
  const link=directLink(f);
  try{await navigator.clipboard.writeText(link);toast("Tracking link copied!")}catch(e){prompt("Copy this link:",link)}
}
function adminLogin(){
  if(document.getElementById("adminPassword").value!==ADMIN_PASSWORD){alert("Incorrect password!");return}
  loggedIn=true;document.getElementById("adminLogin").style.display="none";document.getElementById("adminPanel").style.display="block";renderAdminFiles();toast("Admin login successful");
}
function adminLogout(){loggedIn=false;document.getElementById("adminLogin").style.display="block";document.getElementById("adminPanel").style.display="none";document.getElementById("adminPassword").value=""}
function updateOverview(){
  const a=Object.values(filesDatabase);
  document.getElementById("statTotal").textContent=a.length;
  document.getElementById("statEmbassy").textContent=a.filter(f=>f.status==="At embassy").length;
  document.getElementById("statReady").textContent=a.filter(f=>["Embassy done","Ready to collect"].includes(f.status)).length;
  document.getElementById("statCollected").textContent=a.filter(f=>f.status==="Collected").length;
}
function generateReceipt(){document.getElementById("adminReceipt").value="ATT-2026-"+Math.floor(1000+Math.random()*9000)}
function clearForm(){
  ["editingReceipt","adminReceipt","adminName","adminPhone","adminType","adminMofa"].forEach(id=>document.getElementById(id).value="");
  document.getElementById("adminStatus").value="Received";document.getElementById("formTitle").textContent="Add New File";
}
async function saveFile(){
  const old=document.getElementById("editingReceipt").value;
  const receipt=document.getElementById("adminReceipt").value.trim().toUpperCase();
  const name=document.getElementById("adminName").value.trim();
  const phone=normalizePhone(document.getElementById("adminPhone").value.trim());
  if(!receipt||!name||!phone){alert("Receipt, Name and Phone are required.");return}
  const payload={receipt,name,phone,type:document.getElementById("adminType").value.trim()||"General Document",mofa_ref:document.getElementById("adminMofa").value.trim()||"N/A",status:document.getElementById("adminStatus").value};
  try{
    if(old&&old!==receipt){const d=await db.from("files").delete().eq("receipt",old);if(d.error)throw d.error}
    const {error}=await db.from("files").upsert(payload,{onConflict:"receipt"});
    if(error)throw error;
    clearForm();await fetchAllFiles();toast("File saved online successfully!");
  }catch(e){alert("Save failed: "+e.message)}
}
function renderAdminFiles(){
  const q=document.getElementById("adminSearch").value.trim().toLowerCase();
  const arr=Object.values(filesDatabase).filter(f=>!q||f.name.toLowerCase().includes(q)||f.receipt.toLowerCase().includes(q));
  document.getElementById("adminFiles").innerHTML=arr.length?arr.map(f=>`
  <div class="file">
    <div class="receipt">${esc(f.receipt)}</div><div class="name">${esc(f.name)}</div>
    <div class="meta">Phone: ${esc(f.phone)} | Status: <span style="color:#10b981">${esc(f.status)}</span></div>
    <div class="two"><button class="btn small blue" onclick="editFile('${encodeURIComponent(f.receipt)}')">Edit</button><button class="btn small red" onclick="deleteFile('${encodeURIComponent(f.receipt)}')">Delete</button></div>
  </div>`).join(""):`<div class="empty">No files found.</div>`;
}
function editFile(encoded){
  const f=filesDatabase[decodeURIComponent(encoded)];if(!f)return;
  document.getElementById("editingReceipt").value=f.receipt;document.getElementById("adminReceipt").value=f.receipt;
  document.getElementById("adminName").value=f.name;document.getElementById("adminPhone").value=f.phone;
  document.getElementById("adminType").value=f.type;document.getElementById("adminMofa").value=f.mofaRef==="N/A"?"":f.mofaRef;
  document.getElementById("adminStatus").value=f.status;document.getElementById("formTitle").textContent="Edit File: "+f.receipt;
  window.scrollTo({top:0,behavior:"smooth"});
}
async function deleteFile(encoded){
  const receipt=decodeURIComponent(encoded);
  if(!confirm("Delete "+receipt+"?"))return;
  try{const {error}=await db.from("files").delete().eq("receipt",receipt);if(error)throw error;await fetchAllFiles();toast("File deleted online.")}catch(e){alert("Delete failed: "+e.message)}
}
window.addEventListener("load",fetchAllFiles);
document.getElementById("referenceInput").addEventListener("keydown",e=>{if(e.key==="Enter")executeSearch()});
document.getElementById("phoneInput").addEventListener("keydown",e=>{if(e.key==="Enter")executeSearch()});
</script>
</body>
</html>
